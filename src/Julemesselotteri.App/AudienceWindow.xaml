<Window x:Class="Julemesselotteri.App.AudienceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Julemesselotteri · Publikum" WindowStyle="None" ResizeMode="NoResize"
        Background="#102F29" Foreground="#FFF9E9" ShowActivated="False"
        KeyDown="Window_KeyDown">
    <Viewbox Stretch="Uniform">
        <Grid Width="1600" Height="900">
            <Grid.Background>
                <RadialGradientBrush Center="0.35,0.35" GradientOrigin="0.3,0.25" RadiusX="0.9" RadiusY="1">
                    <GradientStop Color="#205144" Offset="0"/>
                    <GradientStop Color="#0A231F" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>
            <Canvas IsHitTestVisible="False">
                <Ellipse Width="340" Height="340" Fill="#09F4D495" Canvas.Left="-140" Canvas.Top="-140"/>
                <Ellipse Width="440" Height="440" Stroke="#19E8CC91" StrokeThickness="1" Canvas.Left="1100" Canvas.Top="610"/>
                <Ellipse Width="390" Height="390" Stroke="#13E8CC91" StrokeThickness="1" Canvas.Left="1125" Canvas.Top="635"/>
                <Path Stroke="#426453" StrokeThickness="3" Data="M 60,0 L 60,100 M 1500,0 L 1500,130 M 1450,0 L 1450,65"/>
                <Ellipse Width="22" Height="28" Fill="#CFA45A" Canvas.Left="49" Canvas.Top="100"/>
                <Ellipse Width="34" Height="42" Fill="#9C3F38" Canvas.Left="1483" Canvas.Top="130"/>
                <Ellipse Width="16" Height="22" Fill="#DAB46A" Canvas.Left="1442" Canvas.Top="65"/>
                <TextBlock Text="✦" FontSize="26" Foreground="#907B59" Canvas.Left="920" Canvas.Top="155"/>
                <TextBlock Text="✧" FontSize="36" Foreground="#6C775A" Canvas.Left="110" Canvas.Top="730"/>
                <TextBlock Text="✦" FontSize="16" Foreground="#907B59" Canvas.Left="1020" Canvas.Top="760"/>
            </Canvas>
            <Grid Margin="64,48">
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="48"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock Text="JULEMESSELOTTERI" Foreground="#EACB8B" FontSize="22" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="ModeText" FontSize="23" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </DockPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="990"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,0,32">
                        <TextBlock Text="NÅ TREKKER VI" Foreground="#C3CBBB" FontSize="19"
                                   HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <Viewbox MaxHeight="110" Margin="20,0">
                            <TextBlock x:Name="PrizeText" FontSize="50" MaxWidth="900" TextAlignment="Center"
                                       FontWeight="SemiBold" Foreground="#FFF9E9"/>
                        </Viewbox>
                        <TextBlock x:Name="StageText" Text="LODDNUMMER" Foreground="#D8BE85" FontSize="20"
                                   HorizontalAlignment="Center" Margin="0,32,0,20"/>
                        <Viewbox Height="230" MaxWidth="950">
                            <StackPanel x:Name="ReelsPanel" Orientation="Horizontal"/>
                        </Viewbox>
                        <TextBlock x:Name="BookText" FontSize="30" Foreground="#F6D38A"
                                   TextAlignment="Center" Height="50" Margin="0,22,0,0"/>
                        <TextBlock x:Name="HintText" Text="Lykke til!" Foreground="#BDC9B8" FontSize="23"
                                   TextAlignment="Center" Margin="0,16,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="2" Background="#38071713" CornerRadius="18"
                            BorderBrush="#306C8067" BorderThickness="1" Padding="24,28">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="VINNERE" FontSize="20" Foreground="#D8BE85" FontWeight="SemiBold"/>
                                <TextBlock x:Name="WinnerCountText" FontSize="17" Foreground="#BBC6B5" Margin="0,8,0,24"/>
                            </StackPanel>
                            <ListBox x:Name="PublicWinners" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                     Foreground="#FFF9E9" IsHitTestVisible="False" Focusable="False"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Focusable" Value="False"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#306C8067" BorderThickness="0,0,0,1" Padding="0,14">
                                            <StackPanel>
                                                <TextBlock Text="{Binding NumberText}" FontSize="30"
                                                           FontWeight="SemiBold" Foreground="#F6D38A"/>
                                                <TextBlock Text="{Binding Prize}" FontSize="22" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Grid.Row="2" Text="Takk for at du støtter julemessa" FontSize="17"
                                       Foreground="#BCC9B7" Margin="0,20,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
                <TextBlock Grid.Row="2" Text="Små lodd · Stor glede" HorizontalAlignment="Center"
                           VerticalAlignment="Bottom" FontSize="19" Foreground="#A5B5A0"/>
            </Grid>
        </Grid>
    </Viewbox>
</Window>
