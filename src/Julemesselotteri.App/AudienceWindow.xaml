<Window x:Class="Julemesselotteri.App.AudienceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Julemesselotteri · Publikum" WindowStyle="None" ResizeMode="NoResize"
        Background="{StaticResource BrandDark}" Foreground="{StaticResource BrandCream}" ShowActivated="False"
        KeyDown="Window_KeyDown">
    <Viewbox Stretch="Uniform">
        <Grid Width="1600" Height="900" Background="{StaticResource BrandDark}" ClipToBounds="True">
            <Canvas IsHitTestVisible="False">
                <Ellipse Width="320" Height="320" Stroke="{StaticResource Accent}" StrokeThickness="54"
                         Canvas.Left="-200" Canvas.Top="670"/>
                <Ellipse Width="220" Height="220" Stroke="{StaticResource BrandRed}" StrokeThickness="32"
                         Canvas.Left="-150" Canvas.Top="720"/>
                <Path Fill="{StaticResource Accent}" Data="M 1370,0 L 1600,0 L 1600,230 A 230,230 0 0 1 1370,0 Z"/>
                <Path Fill="{StaticResource BrandRed}" Data="M 1460,0 L 1600,0 L 1600,140 A 140,140 0 0 1 1460,0 Z"/>
            </Canvas>
            <Grid Margin="64,48">
                <Grid.RowDefinitions>
                    <RowDefinition Height="120"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="48"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Image x:Name="BrandLogo" Source="{StaticResource YouthCentreLogo}" Width="280" Height="90"
                           Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top"
                           AutomationProperties.Name="Ungdomssenteret"/>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,28,0">
                        <TextBlock Text="JULEMESSELOTTERI" FontSize="20" FontWeight="Bold"/>
                        <TextBlock x:Name="ModeText" FontSize="23" Margin="0,8,0,0" TextAlignment="Right"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="990"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,0,32">
                        <TextBlock Text="NÅ TREKKER VI" Foreground="{StaticResource BrandCream}" FontSize="19"
                                   HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <Viewbox MaxHeight="110" Margin="20,0">
                            <TextBlock x:Name="PrizeText" FontSize="50" MaxWidth="900" TextAlignment="Center"
                                       FontWeight="SemiBold" Foreground="{StaticResource BrandCream}"/>
                        </Viewbox>
                        <TextBlock x:Name="StageText" Text="LODDNUMMER" Foreground="{StaticResource BrandCream}" FontSize="20"
                                   HorizontalAlignment="Center" Margin="0,32,0,20"/>
                        <Viewbox Height="230" MaxWidth="950">
                            <StackPanel x:Name="ReelsPanel" Orientation="Horizontal"/>
                        </Viewbox>
                        <TextBlock x:Name="BookText" FontSize="30" Foreground="{StaticResource BrandCream}"
                                   TextAlignment="Center" Height="50" Margin="0,22,0,0"/>
                        <TextBlock x:Name="HintText" Text="Lykke til!" Foreground="{StaticResource BrandCream}" FontSize="23"
                                   TextAlignment="Center" Margin="0,16,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="2" Background="{StaticResource BrandCream}" CornerRadius="4"
                            BorderBrush="{StaticResource BrandRed}" BorderThickness="0,6,0,0" Padding="24,28"
                            TextElement.Foreground="{StaticResource Ink}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="VINNERE" FontSize="20" Foreground="{StaticResource BrandDark}" FontWeight="SemiBold"/>
                                <TextBlock x:Name="WinnerCountText" FontSize="17" Margin="0,8,0,24"/>
                            </StackPanel>
                            <ListBox x:Name="PublicWinners" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource Ink}" IsHitTestVisible="False" Focusable="False"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Focusable" Value="False"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BrandBorder}" BorderThickness="0,0,0,1" Padding="0,14">
                                            <StackPanel>
                                                <TextBlock Text="{Binding NumberText}" FontSize="30"
                                                           FontWeight="SemiBold" Foreground="{StaticResource BrandDark}"/>
                                                <TextBlock Text="{Binding Prize}" FontSize="22" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Grid.Row="2" Text="Takk for at du støtter julemessa" FontSize="17"
                                       Margin="0,20,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
                <TextBlock Grid.Row="2" Text="Små lodd · Stor glede" HorizontalAlignment="Center"
                           VerticalAlignment="Bottom" FontSize="19" Foreground="{StaticResource BrandCream}"/>
            </Grid>
        </Grid>
    </Viewbox>
</Window>
