<Window x:Class="Julemesselotteri.App.AudienceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Julemesselotteri · Publikum" WindowStyle="None" ResizeMode="NoResize"
        Background="#102F29" Foreground="#FFF9E9" ShowActivated="False"
        KeyDown="Window_KeyDown">
    <Grid Margin="48">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/><ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,48,0">
            <TextBlock x:Name="ModeText" FontSize="32"/>
            <TextBlock x:Name="PrizeText" FontSize="46" FontWeight="SemiBold" Margin="0,24,0,0"/>
            <TextBlock x:Name="NumberText" FontSize="160" FontWeight="Bold" Foreground="#F6D38A"/>
            <TextBlock x:Name="BookText" FontSize="36"/>
        </StackPanel>
        <StackPanel Grid.Column="1">
            <TextBlock Text="Vinnere" FontSize="30" Margin="0,0,0,20"/>
            <ItemsControl x:Name="PublicWinners">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="{Binding NumberText}" FontSize="26" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Prize}" FontSize="22"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</Window>
